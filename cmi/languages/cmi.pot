#: classes/cmi.class.php:203
msgid "CMI Kit Type"
msgstr ""

#: classes/cmi.class.php:205
msgid "<strong>Standard Kit</strong> — Redirects the customer to the CMI hosted payment page. Transaction management (confirmation, void, refund) must be done from the CMI back office.<br><strong>Complete Kit (with API)</strong> — Same as Standard Kit, plus a <strong>CMI Actions</strong> column in the WooCommerce orders list allowing you to <strong>Confirm</strong>, <strong>Void</strong>, and <strong>Refund</strong> transactions directly from your shop."
msgstr ""

#: classes/cmi.class.php:208
msgid "Standard Kit — Hosted Payment Page only"
msgstr ""

#: classes/cmi.class.php:209
msgid "Complete Kit — With API Management (Confirm, Void, Refund)"
msgstr ""

#: classes/cmi.class.php:213
msgid "Payment Confirmation"
msgstr ""

#: classes/cmi.class.php:215
msgid "<strong>Automatic</strong> — The payment is captured immediately when the customer completes checkout via the callback.<br><strong>Manual</strong> — The payment is only authorized (pre-authorized). You must manually confirm it from the orders list to capture the funds if you have the Complete Kit (API), or via the CMI back office if you only have the Standard Kit. CMI does not call your shop's callback in this mode: the order is updated when the customer returns to the shop. With the Complete Kit, the plugin also checks CMI automatically if the order is still pending after 15 minutes, and you can use Check CMI at any time."
msgstr ""

#: classes/cmi.class.php:218
msgid "Automatic — Capture payment immediately"
msgstr ""

#: classes/cmi.class.php:219
msgid "Manual — Pre-authorize only (confirm later)"
msgstr ""

