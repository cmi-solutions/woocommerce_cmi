msgid "Payment Setup"
msgstr ""

#: classes/cmi.class.php:203
msgid "Choose your CMI kit type and configure how payments are processed."
msgstr ""

#: classes/cmi.class.php:206
msgid "CMI Kit Type"
msgstr ""

#: classes/cmi.class.php:208
msgid "<strong>Standard Kit</strong> — Redirects the customer to the CMI hosted payment page. Transaction management (confirmation, void, refund) must be done from the CMI back office.<br><strong>Complete Kit (with API)</strong> — Same as Standard Kit, plus a <strong>CMI Actions</strong> column in the WooCommerce orders list allowing you to <strong>Confirm</strong>, <strong>Void</strong>, and <strong>Refund</strong> transactions directly from your shop. It requires the API credentials provided by CMI (API URL, username and password)."
msgstr ""

#: classes/cmi.class.php:211
msgid "Standard Kit — Hosted Payment Page only"
msgstr ""

#: classes/cmi.class.php:212
msgid "Complete Kit — With API Management (Confirm, Void, Refund)"
msgstr ""

#: classes/cmi.class.php:216
msgid "Payment Confirmation"
msgstr ""

#: classes/cmi.class.php:218
msgid "<strong>Automatic</strong> — The payment is captured immediately when the customer completes checkout via the callback.<br><strong>Manual</strong> — The payment is only authorized (pre-authorized). You must manually confirm it from the orders list to capture the funds if you have the Complete Kit (API), or via the CMI back office if you only have the Standard Kit. If the order stays pending, the plugin also checks CMI automatically (Complete Kit), and you can use Check CMI at any time."
msgstr ""

#: classes/cmi.class.php:221
msgid "Automatic — Capture payment immediately"
msgstr ""

#: classes/cmi.class.php:222
msgid "Manual — Pre-authorize only (confirm later)"
msgstr ""

